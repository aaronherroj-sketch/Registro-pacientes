#include <iostream>
#include <string>

using namespace std;

int main()
{
    string conductor[100];
    float horadellegada[100];
    float horadesalida[100];
    float km[100];

    int op;
    int n;
    int total_registros = 0;

    do
    {
        cout << "MENU" << endl;
        cout << "1. Registrar datos de transporte" << endl;
        cout << "2. Consultar datos de transporte" << endl;
        cout << "3. Modificar datos de transporte" << endl;
        cout << "4. Salir" << endl;
        cout << endl;
        cout << "Digite su opcion: ";
        cin >> op;

        while (cin.fail())
        {
            cin.clear();
            cin.ignore(10000, '\n');
            cout << "Dato incorrecto. Digite una opcion del 1 al 4: ";
            cin >> op;
        }

        cin.ignore(10000, '\n');
        cout << endl;

        switch (op)
        {
            case 1:
            {
                cout << "Cuantos conductores desea registrar?: ";
                cin >> n;

                while (cin.fail() || n <= 0)
                {
                    cin.clear();
                    cin.ignore(10000, '\n');
                    cout << "Dato incorrecto. Ingrese un numero mayor a 0: ";
                    cin >> n;
                }

                if (total_registros + n > 100)
                {
                    cout << "Error: Se supera la capacidad maxima de 100 registros." << endl;
                    break;
                }

                cin.ignore(10000, '\n');

                for (int i = total_registros; i < total_registros + n; i++)
                {
                    cout << endl;
                    cout << "Escriba el nombre del conductor " << i + 1 << ": ";
                    getline(cin, conductor[i]);

                    cout << "Escriba la hora de llegada (0-23): ";
                    cin >> horadellegada[i];

                    while (cin.fail() || horadellegada[i] < 0 || horadellegada[i] >= 24)
                    {
                        cin.clear();
                        cin.ignore(10000, '\n');
                        cout << "Dato incorrecto. Vuelva a introducir la hora de llegada (0-23): ";
                        cin >> horadellegada[i];
                    }

                    cout << "Escriba la hora de salida (0-23): ";
                    cin >> horadesalida[i];

                    while (cin.fail() || horadesalida[i] < 0 || horadesalida[i] >= 24)
                    {
                        cin.clear();
                        cin.ignore(10000, '\n');
                        cout << "Dato incorrecto. Vuelva a introducir la hora de salida (0-23): ";
                        cin >> horadesalida[i];
                    }

                    cout << "Escriba los kilometros recorridos: ";
                    cin >> km[i];

                    while (cin.fail() || km[i] < 0)
                    {
                        cin.clear();
                        cin.ignore(10000, '\n');
                        cout << "Dato incorrecto. Vuelva a introducir los kilometros (>= 0): ";
                        cin >> km[i];
                    }

                    cin.ignore(10000, '\n');
                }

                total_registros += n;

                cout << endl;
                cout << "Guardado exitosamente." << endl;
                cout << endl;

                break;
            }

            case 2:
            {
                if (total_registros == 0)
                {
                    cout << "No hay registros guardados todavia." << endl;
                }
                else
                {
                    cout << "--- LISTA DE TRANSPORTE ---" << endl;

                    for (int i = 0; i < total_registros; i++)
                    {
                        cout << "Conductor " << i + 1 << ": " << conductor[i] << endl;
                        cout << "Hora de llegada: " << horadellegada[i] << endl;
                        cout << "Hora de salida: " << horadesalida[i] << endl;
                        cout << "Kilometros recorridos: " << km[i] << endl;
                        cout << "-------------------------" << endl;
                    }
                }

                cout << endl;
                break;
            }

            case 3:
            {
                if (total_registros == 0)
                {
                    cout << "No hay registros guardados todavia." << endl;
                }
                else
                {
                    cout << "--- LISTA DE TRANSPORTE ACTUAL ---" << endl;

                    for (int i = 0; i < total_registros; i++)
                    {
                        cout << "Conductor " << i + 1 << ": " << conductor[i] << endl;
                        cout << "Hora de llegada: " << horadellegada[i] << endl;
                        cout << "Hora de salida: " << horadesalida[i] << endl;
                        cout << "Kilometros recorridos: " << km[i] << endl;
                        cout << "-------------------------" << endl;
                    }

                    int idx;

                    cout << "Cual conductor desea modificar (1 al "
                         << total_registros << "): ";
                    cin >> idx;

                    while (cin.fail() || idx < 1 || idx > total_registros)
                    {
                        cin.clear();
                        cin.ignore(10000, '\n');

                        cout << "Dato incorrecto. Vuelva a introducir "
                             << "el numero de conductor (1 al "
                             << total_registros << "): ";

                        cin >> idx;
                    }

                    cin.ignore(10000, '\n');

                    int pos = idx - 1;

                    cout << "Nuevo nombre del conductor: ";
                    getline(cin, conductor[pos]);

                    cout << "Nueva hora de llegada (0-23): ";
                    cin >> horadellegada[pos];

                    while (cin.fail() ||
                           horadellegada[pos] < 0 ||
                           horadellegada[pos] >= 24)
                    {
                        cin.clear();
                        cin.ignore(10000, '\n');

                        cout << "Dato incorrecto. Vuelva a introducir "
                             << "la hora de llegada (0-23): ";

                        cin >> horadellegada[pos];
                    }

                    cout << "Nueva hora de salida (0-23): ";
                    cin >> horadesalida[pos];

                    while (cin.fail() ||
                           horadesalida[pos] < 0 ||
                           horadesalida[pos] >= 24)
                    {
                        cin.clear();
                        cin.ignore(10000, '\n');

                        cout << "Dato incorrecto. Vuelva a introducir "
                             << "la hora de salida (0-23): ";

                        cin >> horadesalida[pos];
                    }

                    cout << "Nuevos kilometros recorridos: ";
                    cin >> km[pos];

                    while (cin.fail() || km[pos] < 0)
                    {
                        cin.clear();
                        cin.ignore(10000, '\n');

                        cout << "Dato incorrecto. Vuelva a introducir "
                             << "los kilometros (>= 0): ";

                        cin >> km[pos];
                    }

                    cout << endl;
                    cout << "Modificado exitosamente." << endl;
                }

                cout << endl;
                break;
            }

            case 4:
            {
                cout << "Saliendo del programa..." << endl;
                break;
            }

            default:
            {
                cout << "Opcion invalida. Intente de nuevo." << endl;
                cout << endl;
            }
        }

    } while (op != 4);

    return 0;
}
